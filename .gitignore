# SwiftPM
.build/
.swiftpm/
# NOTE: Package.resolved is COMMITTED on purpose — WhisperKit is pinned loosely
# (from: "0.9.0"), so without the lockfile two people cloning a week apart get
# different builds and no CI would notice.

# Xcode (for the app later)
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# WhisperKit model cache / downloaded models
Models/
*.mlmodelc

# built app bundle (produced by Scripts/build-app.sh)
Screamm.app/

# spike scratch / voice recordings (never commit audio)
*.aiff
*.wav
*.m4a
*.caf
*.mp3

# macOS
.DS_Store

# Local certs / keys — never commit these
*.p12
*.pem
*.cer
